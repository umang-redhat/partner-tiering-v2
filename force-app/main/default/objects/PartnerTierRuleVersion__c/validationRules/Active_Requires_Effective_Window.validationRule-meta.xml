<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Requires_Effective_Window</fullName>
    <active>false</active>
    <description>Active versions must define both in-effect and deactivation dates.</description>
    <errorConditionFormula>
        AND(
            ISPICKVAL(Status__c, "Active"),
            OR(
                ISBLANK(In_Effect_Date__c),
                ISBLANK(Deactivation_Date__c)
            )
        )
    </errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>To release a version, set both In Effect Date and Deactivation Date.</errorMessage>
</ValidationRule>
