<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Deactivation_Window</fullName>
    <active>false</active>
    <description>Deactivation date must not be before in-effect date.</description>
    <errorConditionFormula>
        AND(
            NOT(ISBLANK(Deactivation_Date__c)),
            Deactivation_Date__c &lt; In_Effect_Date__c
        )
    </errorConditionFormula>
    <errorDisplayField>Deactivation_Date__c</errorDisplayField>
    <errorMessage>Deactivation Date must be on or after In Effect Date.</errorMessage>
</ValidationRule>
